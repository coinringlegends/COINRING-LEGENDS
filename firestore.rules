rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: Anyone can create an order, read/write permitted for store administration
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Products catalog: Anyone can view, store administration can update
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Newsletter subscribers
    match /newsletter/{docId} {
      allow create: if true;
      allow read: if true;
    }
  }
}
